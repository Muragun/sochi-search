# =====================================================================
#  Настройки рабочей установки. Заполняется один раз на каждой машине.
#
#  Как пользоваться:
#     cp .env.production.example .env
#     chmod 600 .env
#     nano .env          # заполнить блок «ОБЯЗАТЕЛЬНО»
#
#  Файл содержит пароль и в git не попадает: он перечислен в .gitignore.
#  Всё, что ниже блока «ОБЯЗАТЕЛЬНО», можно не трогать — значения по
#  умолчанию подобраны под машину 4 ядра / 8 ГБ.
# =====================================================================


# =====================================================================
#  ОБЯЗАТЕЛЬНО — без этих трёх строк установка не заработает
# =====================================================================

# Логин для входа в раздел управления (/admin). Сам поиск открыт всем.
ADMIN_USERNAME=admin

# SHA-256 пароля. Считается на любой машине с Python:
#
#   python3 -c "import hashlib,getpass;print(hashlib.sha256(getpass.getpass().encode()).hexdigest())"
#
# Команда спросит пароль, не показывая его на экране, и напечатает 64
# символа — их и вставить сюда. Сам пароль нигде не хранится.
#
# Пока строка пустая, раздел управления отвечает ошибкой и никого не
# пускает. Это сделано намеренно: молча пускать всех опаснее.
ADMIN_PASSWORD_SHA256=

# Адрес, на котором слушает поиск.
#
#   127.0.0.1     — только с самой машины (так безопаснее всего);
#   10.0.0.5      — адрес машины во внутренней сети: зайдут коллеги,
#                   из интернета — никто;
#   0.0.0.0       — все адреса. Так делать не нужно: если у машины есть
#                   внешний адрес, поиск окажется в интернете.
#
# Узнать адрес машины во внутренней сети: hostname -I
API_BIND=127.0.0.1
API_PORT=18084


# =====================================================================
#  Elasticsearch
# =====================================================================

# elasticsearch — имя контейнера из docker-compose.yml. Менять нужно,
# только если Elasticsearch стоит на отдельной машине.
ES_URL=http://elasticsearch:9200
ES_INDEX=sochi_search
ES_USERNAME=
ES_PASSWORD=
ES_VERIFY_TLS=false

# Сколько памяти отдать Elasticsearch.
#
# ES_HEAP — рабочая память Java. Правило: половина памяти машины, но не
# больше 30 ГБ. ES_MEM_LIMIT — потолок всего контейнера: вдвое больше
# heap. Остаток уходит на прямые буферы, стеки потоков и файловый кэш,
# без которого поиск читает с диска.
#
#   8 ГБ на машине  → ES_HEAP=2g,  ES_MEM_LIMIT=4g
#   16 ГБ на машине → ES_HEAP=6g,  ES_MEM_LIMIT=12g
#   32 ГБ на машине → ES_HEAP=12g, ES_MEM_LIMIT=24g
#
# Вдвое, а не в полтора раза, как советовали здесь раньше. Полтора
# выведены из общего правила, замер на рабочей машине показал другое:
# при heap 2 ГБ контейнер занимает 2,57 ГБ в покое — 86 % от потолка в
# 3 ГБ, меньше полугигабайта запаса. Потолок великоват стоит немного
# файлового кэша у соседей; потолок мал — ядро убивает кластер.
#
# Проверить на своей машине:
#   docker stats --no-stream sochi-elasticsearch
ES_HEAP=2g
ES_MEM_LIMIT=4g


# =====================================================================
#  Обход сайта
# =====================================================================

CRAWL_ALLOWED_HOSTS=sochi.ru

# Как обходчик представляется сайту.
#
# Единственная строка проекта, которую видит чужая сторона: в журналах
# sochi.ru она стоит напротив каждого запроса. Версия здесь отстала на
# выпуск и полгода сообщала о 2.5.0 — проверка согласия версий её не
# охватывала, потому что перечисляла места по одному.
#
# Пояснение в скобках оставьте: по нему администратор сайта отличает
# внутренний поиск муниципалитета от неизвестного бота, а это разные
# решения с его стороны.
CRAWL_USER_AGENT=SochiSearch/2.6.0 (+internal municipal search index)
CRAWL_CONNECT_TIMEOUT=10
CRAWL_READ_TIMEOUT=60

# Потолок на размер файла. 50 МБ для обычных, 150 МБ для PDF.
# Файлы крупнее помечаются статусом skipped_too_large и не скачиваются:
# на сайте таких единицы, а один такой файл занимает воркер на десятки
# минут. Найти их потом можно запросом к очереди — см. docs/DEPLOY.md.
CRAWL_MAX_DOWNLOAD_BYTES=52428800
CRAWL_PDF_MAX_DOWNLOAD_BYTES=157286400

CRAWL_BATCH_SIZE=1000
CRAWL_WORKER_BATCH_LIMIT=10
CRAWL_CHUNK_SIZE=3500
CRAWL_CHUNK_OVERLAP=350
CRAWL_MIN_TEXT_LENGTH=80
CRAWL_RECHECK_HOURS=168
CRAWL_RETRY_HOURS=6
CRAWL_MAX_RETRY_ATTEMPTS=5
CRAWL_MISSING_RETRY_HOURS=24
CRAWL_DELETE_MISSING_AFTER=3
CRAWL_LOCK_TIMEOUT_MINUTES=60

DISCOVERY_ROOT_URL=https://sochi.ru/
DISCOVERY_CANONICAL_SCHEME=https
DISCOVERY_CANONICAL_HOST=sochi.ru
DISCOVERY_MAX_SITEMAPS=100
DISCOVERY_MAX_CANDIDATES=100000
DISCOVERY_MAX_NEW_URLS=50000


# =====================================================================
#  Распознавание отсканированных PDF
# =====================================================================

CRAWL_PDF_OCR_ENABLED=true
CRAWL_PDF_OCR_ENGINE=tesseract-cli
CRAWL_TESSERACT_BINARY=tesseract

# Только русский. Добавление eng замедляет распознавание примерно вдвое
# и на документах администрации ничего не даёт.
CRAWL_PDF_OCR_LANGUAGES=rus

CRAWL_PDF_OCR_PSM=3
CRAWL_PDF_OCR_OEM=1
CRAWL_PDF_OCR_THREADS=1
CRAWL_PDF_OCR_MINIMUM_DPI=200
CRAWL_PDF_OCR_MAXIMUM_DPI=300
CRAWL_PDF_OCR_PIXEL_BUDGET=8000000
CRAWL_PDF_OCR_DESKEW=true
CRAWL_PDF_OCR_BINARIZE=true

# Насколько строго отбираются чернила при бинаризации.
#
# Одного значения на все страницы не существует: на обычной архивной
# копии 0,15 даёт 98,4 % против 93,9 % у 0,10, а на сильно засвеченной —
# наоборот, 0,10 даёт 54,6 % против 49,7 %. Поэтому основное значение
# строгое, а мягкое включается второй попыткой.
CRAWL_PDF_OCR_SAUVOLA_K=0.15
CRAWL_PDF_OCR_RETRY_SAUVOLA_K=0.10

# Ниже этой средней уверенности Tesseract страница пробуется ещё раз.
#
# Замеры: чистый скан — 96, обычная архивная копия — 90, выцветшая копия
# с точностью 50 % — 24, повёрнутая страница — 20. Порог 65 лежит в
# пустоте между двумя группами, поэтому нормальные страницы повторов не
# вызывают и не дорожают. Ноль отключает повторы совсем.
CRAWL_PDF_OCR_CONFIDENCE_FLOOR=65

# Повороты перебираются только для страниц с низкой уверенностью.
# Альбомный скан А4 попадает в архив так же часто, как книжный, и до
# появления этой настройки терялся целиком: 16,9 % против 98,3 %.
CRAWL_PDF_OCR_RETRY_ROTATIONS=90,270,180

# Потолок времени на страницу вместе со всеми повторами.
CRAWL_PDF_OCR_LADDER_BUDGET_SECONDS=150

# Сначала охват, потом глубина.
#
# 2 — распознаются первые две страницы каждого скана: там заголовок,
# номер и дата, то есть всё, по чему документ ищут. Так весь корпус
# становится находимым за несколько суток вместо нескольких недель.
#
# Когда первый проход закончится, поставить 0 (без ограничения) и
# запустить второй — он дораспознает документы целиком.
CRAWL_PDF_OCR_COVERAGE_PAGES=2
CRAWL_PDF_OCR_PRIORITY_PAGES=2

CRAWL_PDF_OCR_MAX_PAGES=200
CRAWL_PDF_OCR_ROTATIONS=0
CRAWL_PDF_OCR_PAGE_TIMEOUT_SECONDS=45
CRAWL_PDF_OCR_DOCUMENT_BUDGET_SECONDS=360
CRAWL_PDF_FAST_PROCESS_TIMEOUT_SECONDS=120
CRAWL_PDF_PROCESS_TIMEOUT_SECONDS=600

CRAWL_PDF_OCR_BATCH_DOCUMENTS=25
CRAWL_PDF_OCR_BATCH_DEADLINE_SECONDS=1200
CRAWL_PDF_OCR_CACHE_MAX_BYTES=8589934592


# =====================================================================
#  Поиск
# =====================================================================

# Сколько результатов на странице по умолчанию и сколько можно
# запросить максимум.
SEARCH_DEFAULT_LIMIT=10
SEARCH_MAX_LIMIT=50

# Поля и их веса здесь не задаются. Они привязаны к схеме индекса — у
# `title` и `text` есть подполя `.exact`, у `document_kind` — подполе
# `.text`, — поэтому список объявлен в коде: app_v2/search_query.py,
# константы QUERY_FIELDS и FUZZY_FIELDS.
#
# Прежние строки SEARCH_FIELDS и SEARCH_SOURCE_FIELDS перечисляли поля
# content, body и headings, которых обходчик никогда не заполнял, и на
# запрос уже не влияли. Убраны, чтобы не выглядеть настройкой.


# =====================================================================
#  Ритм фоновых задач (секунды между запусками)
#
#  Пауза отсчитывается ПОСЛЕ окончания прохода, поэтому долгий проход не
#  накладывается на следующий. Уменьшать не нужно: на 4 ядрах работа и
#  так идёт непрерывно.
# =====================================================================

WORKER_INTERVAL=120
WORKER_LIMIT=100
DISCOVERY_INTERVAL=3600
DISCOVERY_MAX_PAGES=1200
DISCOVERY_MAX_DEPTH=4
DISCOVERY_MAX_PAGINATION=120
DISCOVERY_MAX_NEW=10000
DISCOVERY_DELAY=0.15
OCR_INTERVAL=60
PUBLICATION_DATE_INTERVAL=300
PUBLICATION_DATE_LIMIT=200
CONTENT_CLEANUP_INTERVAL=600
CONTENT_CLEANUP_LIMIT=200
BACKUP_INTERVAL=86400


# =====================================================================
#  Резервное копирование индекса
# =====================================================================

# Роль backup за один проход делает две копии: очередь SQLite вместе с
# кодом и снимок индекса Elasticsearch.
#
# Снимок нужен потому, что «индекс производный» верно только на бумаге.
# Собрать его заново означает перераспознать корпус, а это недели
# работы обоих слотов OCR — против часа восстановления из снимка.
#
# Снимки инкрементальные: в хранилище дописываются только новые
# сегменты, поэтому ежедневный снимок стоит примерно столько, сколько
# изменилось за сутки.

# Имя хранилища снимков внутри кластера.
ES_SNAPSHOT_REPOSITORY=sochi

# Путь внутри контейнера Elasticsearch. Обязан совпадать с path.repo из
# docker-compose.yml, иначе кластеру некуда писать.
ES_SNAPSHOT_LOCATION=/snapshots

# Приставка в имени снимка. Уборка старых трогает только снимки с этой
# приставкой: снятый руками при переезде остаётся нетронутым.
ES_SNAPSHOT_PREFIX=auto

# Сколько своих снимков хранить. 0 отключает уборку целиком.
#
# Три — с оглядкой на диск, а не на «сколько хотелось бы». Хранилище
# снимков лежит на том же диске, что и индекс: развёртыванию нужно 20 ГБ,
# индекс занимает восемь, первый снимок стоит столько же. Поднимать это
# значение стоит, посмотрев на `df -h`, а не по умолчанию.
ES_SNAPSHOT_RETENTION=3


# =====================================================================
#  Журналы контейнеров
# =====================================================================

# Драйвер json-file по умолчанию предела не имеет: файл растёт, пока не
# кончится диск, а на нём же лежит индекс. Семь контейнеров работают
# непрерывно, поэтому предел задан явно.
LOG_MAX_SIZE=20m
LOG_MAX_FILES=3


# =====================================================================
#  Раздел управления — необязательное
# =====================================================================

# Сколько часов держится вход, прежде чем попросить пароль заново.
ADMIN_SESSION_HOURS=12

# Ставить в true, только если перед поиском появится HTTPS. При http
# браузер просто не отдаст такую куку обратно, и вход не сработает.
ADMIN_COOKIE_SECURE=false

# Ключ подписи входных кук. Если не задан, выводится из пароля: тогда
# смена пароля сама по себе разлогинивает всех. Отдельный ключ нужен,
# только чтобы разлогинить всех, не меняя пароль.
# ADMIN_SECRET_KEY=
