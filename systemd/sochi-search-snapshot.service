[Unit]
Description=Sochi Search Elasticsearch index snapshot
Documentation=file:/opt/sochi-search/OPERATIONS.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/sochi-search
# Настройки читаются из всех трёх файлов, и порядок здесь значимый:
# systemd применяет их подряд, поэтому следующий перекрывает предыдущий.
# Минус перед путём означает «нет — и ладно».
#
# Так вышло не от любви к запасным вариантам. Развёртывания различаются:
# `deploy.sh` кладёт всё в один `.env`, а установка без Docker на рабочей
# машине разнесена по ролям — `.env.api` у поиска, `.env.crawler` у
# обходчика. Юнит, знающий только про `.env`, на второй из них молча
# берёт значения по умолчанию: не тот адрес кластера, не тот индекс.
#
# Молча — потому что отсутствующий EnvironmentFile ошибкой не считается.
# Снимок при этом делается: не того индекса и не там, где нужно.
#
# Отдельно: на рабочей машине рядом лежит `.env` от первой версии
# сервиса, с именами `ELASTIC_URL` и `INDEX_NAME`. Их этот код не читает
# вовсе, так что вреда от файла нет, но и пользы тоже.
EnvironmentFile=-/opt/sochi-search/.env
EnvironmentFile=-/opt/sochi-search/.env.crawler
EnvironmentFile=-/opt/sochi-search/.env.api
ExecStart=/opt/sochi-search/.venv/bin/python -B -m ops.snapshot
# Снимок инкрементальный, но первый — это весь индекс. Кластер отвечает
# только по завершении, поэтому предел выставлен с запасом.
TimeoutStartSec=2h
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
NoNewPrivileges=true
LockPersonality=true
MemoryDenyWriteExecute=true
# Снимок кладёт файлы не сюда: их пишет сам Elasticsearch, в свой
# path.repo. Отсюда уходит только HTTP-запрос, поэтому в отличие от
# копии очереди эта служба сети требует, а записи на диск — нет.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
