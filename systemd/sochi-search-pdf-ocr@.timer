[Unit]
Description=Расписание фонового OCR, слот %i

[Timer]
OnBootSec=8min

# Прежде интервал был 30 секунд, а служба брала ровно один PDF за запуск.
# При очереди около десяти тысяч документов это давало недели работы, и
# большая часть времени уходила на запуск процесса и повторное скачивание
# файла. Теперь запуск обрабатывает пачку документов до внутреннего
# дедлайна, поэтому частый опрос не нужен.
OnUnitInactiveSec=2min

# Слоты разводятся по времени, чтобы не стартовать одновременно.
RandomizedDelaySec=30s
AccuracySec=10s

# Именно таймер на каждый слот, а не один таймер на общий target:
# `.target` после первого запуска остаётся активным, и повторный старт
# уже активного target ничего не делает. С общим target слоты
# отрабатывали ровно один раз, а дальше расписание молчало.
Unit=sochi-search-pdf-ocr@%i.service

[Install]
WantedBy=timers.target
